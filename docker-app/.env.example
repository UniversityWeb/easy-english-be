# ========== Database Configuration ==========
POSTGRES_USER=easyenglish
POSTGRES_PASSWORD=easyenglish123
POSTGRES_DB=EasyEnglish

# ========== pgAdmin Configuration ==========
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin

# ========== Application Configuration ==========
PROD_BASE_URL=http://localhost:8001
PROD_DB_URL=easy-english-db:5432/EasyEnglish
PROD_DB_USER=easyenglish
PROD_DB_PASSWORD=easyenglish123

# ========== Redis Configuration ==========
PROD_REDIS_HOST=redis
PROD_REDIS_PORT=6379
PROD_REDIS_PASS=redis123
PROD_REDIS_TIMEOUT=60000

# ========== MinIO Configuration ==========
PROD_MINIO_URL=http://minio:9000
PROD_MINIO_ACCESS_KEY=minioadmin
PROD_MINIO_SECRET_KEY=minioadmin
PROD_MINIO_BUCKET_NAME=easy-english

# ========== JWT Configuration ==========
PROD_JWT_SECRET_KEY=your-secret-key-change-in-production

# ========== Frontend Configuration ==========
PROD_FRONTEND_URL=http://localhost:3000

# ========== Email Configuration ==========
PROD_SENDING_EMAIL_ADDRESS=your-email@gmail.com
PROD_SENDING_EMAIL_PASSWORD=your-app-password

# ========== VNPay Configuration ==========
PROD_VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paygate/pay.html
PROD_VNPAY_TMN_CODE=your-tmn-code
PROD_VNPAY_HASH_SECRET=your-hash-secret

# ========== Google OAuth Configuration ==========
PROD_GOOGLE_CLIENT_ID=your-google-client-id
PROD_GOOGLE_CLIENT_SECRET=your-google-client-secret

# ========== Gemini API Configuration ==========
PROD_GEMINI_URL=https://generativelanguage.googleapis.com
PROD_GEMINI_API_KEY=your-gemini-api-key

# ========== Spring Profile ==========
SPRING_PROFILES_ACTIVE=prod